{
  "name": "site-copy",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22"
  },
  "bin": {
    "site": "./bin/site"
  },
  "scripts": {
    "site": "node --import tsx src/cli/index.ts",
    "test": "vitest run",
    "test:unit": "vitest run test/unit",
    "test:integration": "vitest run test/integration",
    "test:real": "SITE_REAL_CLAUDE=1 vitest run",
    "typecheck": "tsc --noEmit",
    "lint": "eslint .",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "check": "npm run typecheck && npm run lint && npm run format:check"
  },
  "dependencies": {
    "commander": "^15.0.0",
    "css-tree": "^3.2.1",
    "execa": "^10.0.1",
    "pixelmatch": "^7.2.0",
    "playwright": "^1.63.0",
    "pngjs": "^7.0.0",
    "zod": "^4.6.5"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.5",
    "@types/css-tree": "^3.2.0",
    "@types/node": "^22.0.0",
    "@types/pngjs": "^6.0.5",
    "eslint": "^9.39.5",
    "eslint-plugin-import": "^2.32.0",
    "prettier": "^3.6.0",
    "tsx": "^4.23.13",
    "typescript": "^5.9.0",
    "typescript-eslint": "^8.70.0",
    "vite": "^7.0.0",
    "vitest": "^5.0.1"
  }
}
